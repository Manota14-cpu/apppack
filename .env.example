# Postgres — la MISMA base que usa la tienda (packdistribuidora).
# AppPack administra la tabla `Product` que muestra la web: no hay catálogo
# duplicado. Copiá la cadena del panel de Neon → Connection string.
# Nunca llega al navegador: vive solo en el servidor.
DATABASE_URL="postgresql://usuario:clave@host/neondb?sslmode=verify-full"

# Contraseña única del panel.
# Cambiarla cierra al instante todas las sesiones abiertas en cualquier dispositivo.
ADMIN_PASSWORD="cambiar-esta-contrasena"

# Opcional: invalida todas las sesiones sin tener que cambiar la contraseña.
# SESSION_SECRET=

# ── Aviso instantáneo a la tienda (opcional) ──
# Sin esto, un cambio tarda hasta 60 segundos en verse en la web y a veces hay
# que refrescar dos veces. Con esto, se ve en el próximo reload.
# Poné el MISMO valor de REVALIDATE_SECRET en las dos aplicaciones.
# TIENDA_URL="https://packdistribuidora.com.ar"
# REVALIDATE_SECRET=

# ── Fotos de producto (opcional) ──
# Se llena solo al crear un almacén de Blob en Vercel (Storage → Create → Blob).
# Sin esto se pueden cargar imágenes pegando su dirección, pero no subirlas
# desde el celular.
# BLOB_READ_WRITE_TOKEN=

# ── Avisos automáticos de reposición (opcional) ──
# Una vez por día AppPack mira el stock y los pedidos, y avisa solo si hay algo
# que atender. Hace falta CRON_SECRET y AL MENOS un canal.

# Autoriza la tarea diaria. Cualquier texto largo al azar: openssl rand -hex 32
# CRON_SECRET=

# Canal 1 — correo. Clave gratuita en resend.com.
# RESEND_API_KEY=
# AVISOS_EMAIL_DESTINO="tu@correo.com"
# Remitente. El de fábrica solo escribe a la casilla de la propia cuenta de
# Resend; para otras direcciones hay que verificar un dominio.
# AVISOS_EMAIL_ORIGEN="AppPack <onboarding@resend.dev>"

# Canal 2 — webhook. Recibe el aviso ya escrito, listo para reenviar por donde
# quieras (incluido un puente de WhatsApp).
# AVISOS_WEBHOOK_URL=

# Dirección de esta app, para los enlaces dentro del aviso.
# APPPACK_URL="https://apppack.vercel.app"
